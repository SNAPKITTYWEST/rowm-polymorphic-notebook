[package]
name = "notebook-orchestrator"
version = "1.0.0"
edition = "2021"
license = "MIT OR Apache-2.0"
authors = ["SNAPKITTYWEST"]
description = "Non-recursive orchestration runtime for LOC triad dispatch"

[dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
sha2 = "0.10"
uuid = { version = "1.0", features = ["v4"] }

[dev-dependencies]
